# Django
DJANGO_SECRET_KEY=troque_esta_chave_secreta

# Banco de dados PostgreSQL (usado em local.py / staging / production)
DB_NAME=sipat
DB_USER=sipat
DB_PASSWORD=troque_esta_senha
DB_HOST=db
DB_PORT=5432

# Email
# Em desenvolvimento use console; em produção use smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu@email.com
EMAIL_HOST_PASSWORD=sua_senha_de_app
DEFAULT_FROM_EMAIL=SIPAT <noreply@mppe.mp.br>

# URL pública do sistema (usada nos emails enviados aos usuários)
SIPAT_URL=https://sipat.mppe.mp.br

# Evolution API — envio de mensagens de WhatsApp
# Roda como serviço no próprio docker-compose.yml (container "evolution").
# Se as 3 primeiras ficarem vazias, o envio é simplesmente pulado (com aviso no log), sem quebrar nada.
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=troque_esta_api_key
EVOLUTION_INSTANCE=sipat
# Senha do banco Postgres dedicado do Evolution (container evolution-db)
EVOLUTION_DB_PASSWORD=troque_esta_senha
# URL pública/acessível onde o Evolution está exposto (usada internamente por ele mesmo)
EVOLUTION_SERVER_URL=http://localhost:8080
