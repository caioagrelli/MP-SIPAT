# ── Stage 1: collect static assets ───────────────────────────────────────────
FROM python:3.12-slim AS staticbuilder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

COPY . .

RUN DJANGO_SECRET_KEY=build-time-placeholder \
    DJANGO_ALLOWED_HOSTS=localhost \
    DJANGO_SETTINGS_MODULE=app.settings.production \
    python manage.py collectstatic --noinput


# ── Stage 2: nginx image ──────────────────────────────────────────────────────
FROM nginx:alpine

# Remove default nginx site
RUN rm /etc/nginx/conf.d/default.conf

# Custom nginx config
COPY nginx.conf /etc/nginx/conf.d/sipat.conf

# Static assets collected in stage 1
COPY --from=staticbuilder /app/staticfiles /srv/static

# Empty media directory — mount a persistent volume here at runtime
RUN mkdir -p /srv/media
VOLUME /srv/media

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
